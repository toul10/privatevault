#!/bin/zsh
# PrivateVault pre-push: refuses the push if ANY commit or annotated tag being pushed contains a vault file, a
# backup, signing material, a secret, or an e-mail address that is not a GitHub noreply address. Nothing is sent
# when it refuses. Enabled by: git config core.hooksPath .githooks      Bypass only with --no-verify (don't).
set -uo pipefail
remote="$1"
root="$(git rev-parse --show-toplevel)"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue                          # deleting a remote ref: nothing to scan
  case "$(git cat-file -t "$local_sha" 2>/dev/null)" in
    commit) ;;
    tag) "$root/Scripts/secret-scan.sh" --tag "$local_sha" || rc=1 ;;
    *) echo "BLOCKED: $local_ref points to an object that is not a commit — refusing an unusual push."; rc=1; continue;;
  esac
  target=$(git rev-parse --verify --quiet "$local_sha^{commit}") \
    || { echo "BLOCKED: $local_ref does not lead to a commit — refusing an unusual push."; rc=1; continue; }
  if [[ "$remote_sha" != "$zero" ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    revs=("$target" --not "$remote_sha")                              # update: only the new commits
  else
    revs=("$target" --not --remotes="$remote")                        # new ref: every commit the remote lacks
  fi
  "$root/Scripts/secret-scan.sh" --commits "${revs[@]}" || rc=1
done
(( rc == 0 )) || echo "✗ push refused by .githooks/pre-push — nothing was sent." >&2
exit $rc

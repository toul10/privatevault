#!/bin/zsh
# PrivateVault pre-push: refuses the push if ANY commit being pushed contains a vault file, a backup, signing
# material, a secret, or an e-mail address that is not a GitHub noreply address. Nothing is sent when it refuses.
# Enabled by: git config core.hooksPath .githooks      Bypass only with --no-verify (don't).
set -uo pipefail
remote="$1"
root="$(git rev-parse --show-toplevel)"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue                          # deleting a remote branch: nothing to scan
  if [[ "$remote_sha" != "$zero" ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    revs=("$remote_sha..$local_sha")                                  # update: only the new commits
  else
    revs=("$local_sha" --not --remotes="$remote")                     # new branch: every commit the remote lacks
  fi
  "$root/Scripts/secret-scan.sh" --commits "${revs[@]}" || rc=1
done
(( rc == 0 )) || echo "✗ push refused by .githooks/pre-push — nothing was sent." >&2
exit $rc

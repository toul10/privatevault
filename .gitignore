# Build products
.build/
dist/
*.dSYM
*.o
*.xcuserstate
xcuserdata/
DerivedData/
.swiftpm/xcode/
Package.resolved.bak

# NEVER commit vault data, backups, recovery material or signing secrets
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.privatevault
*.p12
*.pem
*.key
*.mobileprovision
*.provisionprofile
*.p8
*.keychain
*.keychain-db
*.certSigningRequest
*.cer
# exported Recovery Kit text files (never source files)
*Recovery Kit*.txt
*recovery-kit*.txt
Packaging/*.cer
# archives, git bundles and documents never belong here (backups, exports, personal notes)
*.bundle
*.zip
*.dmg
*.rtf
*.rtfd/
# .env files hold real API keys: import them into the app, never commit them
.env
*.env
.env.*

# macOS / editor noise
.DS_Store
*.swp
.vscode/
.idea/

# Frozen format fixtures (FAKE credentials, documented in Tests/VaultCoreTests/Vault/GoldenFixtureTests.swift)
!Tests/VaultCoreTests/Fixtures/golden-v1.sqlite
!Tests/VaultCoreTests/Fixtures/golden-v1.privatevault
